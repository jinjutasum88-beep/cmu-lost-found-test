rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verifiedCmu() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@([a-zA-Z0-9-]+[.])*cmu[.]ac[.]th');
    }

    // ใช้ custom claim แทนการอ่านเอกสาร users ทุกครั้ง
    // เดิมใช้ get() ซึ่งคิดเป็น 1 read ต่อการตรวจ 1 เอกสาร แอดมินอ่าน 100 โพสต์ = 200 reads
    // ตั้ง claim ด้วย scripts/set-admin.mjs
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- โปรไฟล์ผู้ใช้ ----------
    match /users/{userId} {
      allow read:   if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == userId
                    && changedKeys().hasOnly(['displayName','phone','faculty','notifyEmail','lang','postCountDate','postCountToday']);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // ---------- ประกาศ ----------
    // ผู้ใช้เห็นได้เฉพาะประกาศของตัวเอง การจับคู่ทำฝั่งเซิร์ฟเวอร์ซึ่งข้าม rules
    match /posts/{postId} {
      allow read: if verifiedCmu() && (resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if verifiedCmu()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorEmail == request.auth.token.email
                    && request.resource.data.type in ['lost', 'found']
                    && request.resource.data.status == 'active'
                    && request.resource.data.processed is bool
                    && request.resource.data.autoCategorized is bool
                    && (request.resource.data.autoCategorized == true
                        || request.resource.data.processed == false)
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.category.size() <= 60
                    && request.resource.data.color.size() <= 40
                    && request.resource.data.location.size() <= 120
                    // เก็บเฉพาะรูปย่อในเอกสารหลัก รูปเต็มอยู่ที่ postImages
                    && request.resource.data.thumbUrl.size() < 60000;

      // เจ้าของแก้ไขรายละเอียดประกาศของตัวเองได้ แต่เปลี่ยนเจ้าของหรือฟิลด์ระบบไม่ได้
      allow update: if verifiedCmu() && (
                      (resource.data.authorId == request.auth.uid
                       && changedKeys().hasOnly(['type','category','color','description','location','eventDate','pickupNote','thumbUrl','hasImage','status'])
                       && request.resource.data.status in ['active','resolved'])
                      || (isAdmin()
                          && changedKeys().hasOnly(['status','hiddenReason','hiddenAt']))
                    );

      allow delete: if verifiedCmu() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---------- รูปเต็ม แยกออกมาเพื่อไม่ให้หน้ารายการต้องโหลดรูปทั้งหมด ----------
    match /postImages/{postId} {
      allow read:   if verifiedCmu()
                    && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if verifiedCmu()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.data.size() < 750000;
      allow update: if verifiedCmu()
                    && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.data.size() < 750000;
      allow delete: if verifiedCmu()
                    && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ---------- ผลการจับคู่ ----------
    // เขียนโดยเซิร์ฟเวอร์เท่านั้น ต้องได้รับความยินยอมจากทั้งสองฝ่ายก่อนเปิดเผยข้อมูลติดต่อ
    match /matches/{matchId} {
      allow read: if verifiedCmu()
                  && (request.auth.uid in resource.data.participantIds || isAdmin());

      allow create, delete: if false;

      allow update: if verifiedCmu()
                    && changedKeys().hasOnly(['matchStatus'])
                    && (
                      // ขั้นที่ 1 เจ้าของของหายตัดสินว่าใช่ของตัวเองหรือไม่
                      (resource.data.lostAuthorId == request.auth.uid
                       && resource.data.matchStatus == 'waiting_for_user'
                       && request.resource.data.matchStatus in ['awaiting_finder', 'rejected'])
                      ||
                      // ขั้นที่ 2 ผู้ที่เก็บของได้ยินยอมให้เปิดเผยข้อมูลติดต่อหรือไม่
                      (resource.data.foundAuthorId == request.auth.uid
                       && resource.data.matchStatus == 'awaiting_finder'
                       && request.resource.data.matchStatus in ['accepted', 'declined'])
                    );
    }

    // ---------- การรายงานเนื้อหาไม่เหมาะสม ----------
    match /reports/{reportId} {
      allow read:   if isAdmin();
      allow create: if verifiedCmu()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 500;
      allow update: if isAdmin() && changedKeys().hasOnly(['status','handledAt']);
      allow delete: if false;
    }

    // ---------- เวกเตอร์ embedding — เซิร์ฟเวอร์เท่านั้น ----------
    match /embeddings/{postId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
